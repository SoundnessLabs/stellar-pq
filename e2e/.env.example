# Required. Stellar account secret used to pay fees and to fund the
# newly-deployed smart account. On testnet the easiest way to get one:
#
#     stellar keys generate --fund e2e-source --network testnet
#     stellar keys show e2e-source
#
SOURCE_SECRET=

# Optional. Where the recipient of the smart-account-funded transfer goes.
# Defaults to the SOURCE account's public key (i.e. you fund yourself).
RECIPIENT_PK=

# Optional. 96-hex-char (48 bytes) seed for the Falcon-512 keypair. If
# unset, the harness generates a fresh seed each run and writes it to
# the receipt JSON for reproducibility.
FALCON_SEED=

# Network configuration. Defaults shown; override only if you are pointed
# at a private RPC or a non-testnet network.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NATIVE_SAC_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional path to the deployed-contract WASM. Defaults to the workspace
# build output `target/wasm32v1-none/release/soroban_falcon_smart_account.wasm`.
WASM_PATH=

# Amount (XLM) to fund the smart-account with at deploy time, and the
# amount it sends back to RECIPIENT_PK. Smaller values save testnet XLM.
FUND_AMOUNT_XLM=20
TRANSFER_AMOUNT_XLM=1
